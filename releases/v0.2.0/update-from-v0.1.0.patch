+  return t(`dm.${m.kind}`, { n, item: m.item ? t(`item.${m.item}`) : '' });
+}
+
+function untilMidnight() {
+  const now = new Date();
+  const next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
+  return (next.getTime() - now.getTime()) / 1000;
+}
+
+export function DailyPanel() {
