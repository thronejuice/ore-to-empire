+            {s.daily.bonusClaimed ? t('ui.claimed') : t('ui.claim')}
+          </button>
+        </div>
+      </div>
+      <p className="small dim center">{t('ui.resetsIn', { time: fmtClock(untilMidnight()) })}</p>
+    </Modal>
+  );
