# Copy to .env and fill in. Without these the game runs offline (guest only).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Omise dashboard → Keys (PUBLIC key only — the secret key goes into Supabase secrets)
VITE_OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxx
# LINE Developers → your LINE Login channel → Channel ID
VITE_LINE_CHANNEL_ID=1234567890
# Optional: Cloudflare Turnstile site key (bot check when creating player accounts).
# Set TURNSTILE_SECRET in Supabase secrets too, or leave both empty.
VITE_TURNSTILE_SITE_KEY=
